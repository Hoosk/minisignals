{
  "name": "@hoosk/minisignals",
  "version": "1.2.0",
  "description": "Minimal agnostic signals library",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "vitest run",
    "bench": "npm run build && node ./bench/core.bench.mjs"
  },
  "keywords": [
    "signals",
    "reactive",
    "reactivity",
    "state",
    "computed",
    "effect",
    "signal",
    "observable",
    "framework-agnostic"
  ],
  "author": "Hoosk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hoosk/minisignals.git",
    "directory": "packages/core"
  }
}
